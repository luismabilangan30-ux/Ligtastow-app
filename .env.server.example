# Copy to .env.server.local. Server only; never prefix these names with VITE_.
# From Supabase > Connect > Session pooler, copy the PostgreSQL URI.
# Replace [YOUR-PASSWORD] locally using the database password you saved.
# Percent-encode special characters in the password portion of the URI.
DATABASE_URL=REPLACE_WITH_SESSION_POOLER_CONNECTION_URI

# Optional absolute path to the Supabase database CA certificate if required.
# TLS verification stays enabled; never use rejectUnauthorized=false.
DATABASE_CA_FILE=
